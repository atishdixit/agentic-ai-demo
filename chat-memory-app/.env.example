# Copy this file to .env and adjust as needed.

# --- MySQL (conversation memory storage) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=chatmemory
MYSQL_USER=chatapp
MYSQL_PASSWORD=chatapp
# Only used by docker-compose to initialize the MySQL container itself.
MYSQL_ROOT_PASSWORD=root

# --- Ollama model connection ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Chat behaviour ---
CHAT_TEMPERATURE=0.6
CHAT_MAX_TOKENS=300
# How many recent messages (combined user+assistant) the model is shown per turn.
CHAT_MEMORY_WINDOW=10

# --- Ports ---
API_PORT=8081
UI_PORT=4200

# --- CORS: the Angular app's origin ---
UI_ORIGIN=http://localhost:4200
